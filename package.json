{
  "name": "hotkeysplus-obsidian",
  "version": "0.2.7",
  "description": "Hotkeys to do common stuff in Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"*.{ts,mjs}\" \"tests/**/*.mjs\"",
    "format:check": "prettier --check \"*.{ts,mjs}\" \"tests/**/*.mjs\"",
    "test": "node --test tests/",
    "ci": "npm run typecheck && npm run format:check && npm run build && npm test",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.14.4",
    "prettier": "^3.3.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0"
  }
}
